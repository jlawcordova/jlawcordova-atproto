{
  "lexicon": 1,
  "id": "com.jlawcordova.profile.accomplishment",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A single career accomplishment. Records are public.",
      "record": {
        "type": "object",
        "required": ["title", "description", "createdAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 2000,
            "maxGraphemes": 200,
            "description": "Short headline of the accomplishment."
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "maxGraphemes": 1000,
            "description": "What was done and its impact, impact first."
          },
          "funTitle": {
            "type": "string",
            "maxLength": 600,
            "maxGraphemes": 60,
            "description": "Playful one-to-three-word name shown on the portfolio's achievement list."
          },
          "shortDescription": {
            "type": "string",
            "maxLength": 800,
            "maxGraphemes": 80,
            "description": "Five-to-seven-word line shown under the fun title."
          },
          "icon": {
            "type": "string",
            "maxLength": 320,
            "maxGraphemes": 32,
            "knownValues": ["sprout", "hammer", "rocket", "bug", "shield", "key", "wrench", "book", "magnifier", "flask", "apple", "heart", "signpost", "chest", "trophy", "speech"],
            "description": "ID of the pixel-art icon. Advisory: the site shows a fallback for an unknown ID."
          },
          "done": {
            "type": "boolean",
            "default": true,
            "description": "False marks a locked accomplishment (a goal not reached yet), which has no dates. Absent means done."
          },
          "startDate": {
            "type": "string",
            "minLength": 7,
            "maxLength": 7,
            "description": "Month it started or happened, as YYYY-MM. Required unless done is false."
          },
          "endDate": {
            "type": "string",
            "minLength": 7,
            "maxLength": 7,
            "description": "Month it finished, as YYYY-MM. Not before startDate. Omit if ongoing or a single month."
          },
          "tags": {
            "type": "array",
            "maxLength": 10,
            "items": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
            "description": "Skills, technologies, or themes."
          },
          "links": {
            "type": "array",
            "maxLength": 10,
            "items": { "type": "string", "format": "uri" },
            "description": "Evidence such as PRs, articles, demos, or press. http or https only."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the record was created."
          }
        }
      }
    }
  }
}
